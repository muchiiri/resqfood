# Copy this file to .env.local for local development, and set the same two names in Netlify
# (Site configuration, Environment variables). Never put real keys in this file.
#
# Both values are in the Supabase dashboard under Project Settings, API.
# They are public values (they reach the browser), but they are still set per environment.

# The project URL, for example https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The "anon" public key. Never use the service role key here or anywhere in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
